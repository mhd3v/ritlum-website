---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  width: number;
  height: number;
  phone?: boolean;
}

const { src, alt, caption, width, height, phone = false } = Astro.props;
---

<figure class:list={["figure", { phone }]}>
  <div class="stage">
    <img src={src} alt={alt} width={width} height={height} loading="lazy" />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 32px 0 36px;
  }

  .stage {
    display: flex;
    justify-content: center;
    padding: 28px;
    border-radius: 22px;
    background: #eceae7;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }

  .phone .stage {
    padding: 32px 28px 0;
    overflow: hidden;
  }

  .phone img {
    width: min(280px, 70%);
    aspect-ratio: 920 / 1200;
    object-fit: cover;
    object-position: top;
    border-radius: 34px 34px 0 0;
    box-shadow:
      0 0 0 1px rgba(20, 19, 22, 0.08),
      0 18px 40px -18px rgba(20, 19, 22, 0.35);
  }

  figcaption {
    margin-top: 12px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
    text-align: center;
  }
</style>
