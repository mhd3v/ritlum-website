---
interface Props {
  title: string;
  description: string;
  ogType?: "website" | "article";
  ogImage?: string;
}

const {
  title,
  description,
  ogType = "website",
  ogImage = "https://ritlum.com/assets/mini/og.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&display=swap"
    />
    <link rel="alternate" type="application/rss+xml" title="Ritlum Blog" href="/blog/rss.xml" />
    <meta name="apple-itunes-app" content="app-id=6788856420" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Ritlum" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-TZEBVLWPWQ"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-TZEBVLWPWQ");
    </script>

    <style>
      :root {
        color-scheme: light;
        --bg: #faf8f4;
        --bg-alt: #f2efea;
        --card: #ffffff;
        --ink: #0a0a0a;
        --ink-2: #3a3a3a;
        --muted: #7a7570;
        --faint: #aaa49c;
        --border: rgba(15, 15, 15, 0.08);
        --blue: #3d7bf7;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        height: 100%;
      }

      body {
        margin: 0;
        min-height: 100%;
        display: flex;
        flex-direction: column;
        background: var(--bg);
        color: var(--ink);
        font-family:
          Geist,
          -apple-system,
          BlinkMacSystemFont,
          "SF Pro Display",
          system-ui,
          sans-serif;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      a {
        color: inherit;
        text-underline-offset: 3px;
      }

      ::selection {
        background: rgba(91, 157, 249, 0.3);
      }

      .site-header {
        position: sticky;
        top: 12px;
        z-index: 40;
        flex-shrink: 0;
        padding: 0 12px;
      }

      .nav {
        position: relative;
        width: min(1040px, 100%);
        height: 56px;
        margin: 0 auto;
        padding: 0 8px 0 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        border-radius: 999px;
        background: rgba(250, 248, 244, 0.78);
        backdrop-filter: saturate(1.6) blur(20px);
        -webkit-backdrop-filter: saturate(1.6) blur(20px);
        box-shadow:
          0 0 0 1px var(--border),
          0 10px 30px -14px rgba(20, 19, 22, 0.25);
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--ink);
        font-size: 19px;
        font-weight: 650;
        letter-spacing: -0.03em;
        text-decoration: none;
      }

      .mark {
        width: 26px;
        height: 26px;
        padding: 5px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2px;
        border-radius: 7px;
        background: #111014;
      }

      .mark i {
        border-radius: 50%;
        background: #3a383e;
      }
      .mark i:nth-child(1),
      .mark i:nth-child(9) {
        background: #5b9df9;
      }
      .mark i:nth-child(2) {
        background: #62c089;
      }
      .mark i:nth-child(4) {
        background: #f0a05a;
      }
      .mark i:nth-child(5) {
        background: #e78aae;
      }
      .mark i:nth-child(6) {
        background: #6fc8d6;
      }
      .mark i:nth-child(8) {
        background: #a893db;
      }

      .navlinks {
        display: flex;
        gap: 4px;
        font-size: 14px;
      }

      .navlinks a {
        padding: 8px 12px;
        border-radius: 999px;
        color: var(--muted);
        text-decoration: none;
        transition:
          color 0.2s,
          background 0.2s;
      }

      .navlinks a:hover,
      .navlinks a[aria-current] {
        color: var(--ink);
      }

      .navlinks a[aria-current] {
        background: rgba(20, 19, 22, 0.06);
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .button-small {
        display: inline-flex;
        align-items: center;
        min-height: 40px;
        padding: 0 18px;
        border-radius: 999px;
        background: var(--ink);
        color: #fff;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
      }

      .nav-toggle {
        display: none;
        width: 44px;
        height: 44px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: var(--ink);
        align-items: center;
        justify-content: center;
        cursor: pointer;
      }

      .nav-toggle span {
        position: relative;
        width: 18px;
        height: 12px;
        display: block;
      }

      .nav-toggle i {
        position: absolute;
        left: 0;
        right: 0;
        height: 1.6px;
        border-radius: 1px;
        background: currentColor;
        transition:
          transform 0.25s,
          opacity 0.2s;
      }
      .nav-toggle i:nth-child(1) {
        top: 0;
      }
      .nav-toggle i:nth-child(2) {
        top: 5.2px;
      }
      .nav-toggle i:nth-child(3) {
        top: 10.4px;
      }
      .menu-open .nav-toggle i:nth-child(1) {
        transform: translateY(5.2px) rotate(45deg);
      }
      .menu-open .nav-toggle i:nth-child(2) {
        opacity: 0;
      }
      .menu-open .nav-toggle i:nth-child(3) {
        transform: translateY(-5.2px) rotate(-45deg);
      }

      footer {
        flex-shrink: 0;
        width: min(1040px, 100% - 40px);
        margin: 0 auto;
        padding: 32px 0 calc(32px + env(safe-area-inset-bottom, 0px));
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 13px;
      }

      footer .brand {
        font-size: 18px;
      }

      footer a {
        text-decoration: none;
      }

      footer a:hover {
        color: var(--ink);
      }

      :global(main) {
        flex: 1 0 auto;
      }

      @media (max-width: 760px) {
        .nav {
          height: 52px;
        }

        .nav-toggle {
          display: inline-flex;
        }

        .navlinks {
          position: absolute;
          top: calc(100% + 8px);
          left: 0;
          right: 0;
          flex-direction: column;
          gap: 2px;
          padding: 8px;
          font-size: 17px;
          border-radius: 24px;
          background: rgba(250, 248, 244, 0.96);
          backdrop-filter: saturate(1.6) blur(20px);
          -webkit-backdrop-filter: saturate(1.6) blur(20px);
          box-shadow:
            0 0 0 1px var(--border),
            0 18px 40px -16px rgba(20, 19, 22, 0.3);
          opacity: 0;
          visibility: hidden;
          transform: translateY(-6px);
          transition:
            opacity 0.2s,
            transform 0.3s,
            visibility 0s 0.3s;
        }

        .navlinks a {
          display: flex;
          align-items: center;
          min-height: 48px;
          padding: 0 16px;
          color: var(--ink);
        }

        .menu-open .navlinks {
          opacity: 1;
          visibility: visible;
          transform: none;
          transition:
            opacity 0.2s,
            transform 0.3s,
            visibility 0s;
        }

        footer {
          width: min(100% - 32px, 760px);
          flex-direction: column;
          align-items: flex-start;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav" aria-label="Primary">
        <a class="brand" href="/" aria-label="Ritlum home">
          <span class="mark" aria-hidden="true">
            <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
          </span>
          Ritlum
        </a>
        <div class="navlinks" id="navlinks">
          <a href="/">Ritlum mini</a>
          <a href="/app/">App</a>
          <a href="/blog/" aria-current={Astro.url.pathname === "/blog/" ? "page" : "true"}>Blog</a>
          <a href="/contact/">Contact</a>
        </div>
        <div class="nav-actions">
          <a
            class="button-small"
            href="https://apps.apple.com/us/app/ritlum-habit-tracker/id6788856420"
            target="_blank"
            rel="noopener noreferrer">Get the app</a
          >
          <button
            class="nav-toggle"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="navlinks"
          >
            <span aria-hidden="true"><i></i><i></i><i></i></span>
          </button>
        </div>
      </nav>
    </header>

    <slot />

    <footer>
      <a class="brand" href="/" aria-label="Ritlum home">
        <span class="mark" aria-hidden="true">
          <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
        </span>
        Ritlum
      </a>
      <span>
        © 2026 · <a href="/app/">App</a> · <a href="/blog/">Blog</a> · <a href="/privacy/">Privacy</a> · <a href="/contact/">Contact</a>
      </span>
    </footer>

    <script>
      const header = document.querySelector(".site-header")!;
      const toggle = header.querySelector<HTMLButtonElement>(".nav-toggle")!;
      const setOpen = (open: boolean) => {
        header.classList.toggle("menu-open", open);
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      };
      toggle.addEventListener("click", () => setOpen(!header.classList.contains("menu-open")));
      header.querySelectorAll(".navlinks a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
      document.addEventListener("keydown", (e) => e.key === "Escape" && setOpen(false));
    </script>
  </body>
</html>
